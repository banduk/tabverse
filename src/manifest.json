{
  "name": "__MSG_extName__",
  "manifest_version": 3,
  "minimum_chrome_version": "140",
  "description": "__MSG_extDescription__",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Tabverse — abrir painel lateral",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "default_locale": "en",
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "permissions": [
    "tabs",
    "tabGroups",
    "scripting",
    "storage",
    "unlimitedStorage",
    "activeTab",
    "idle",
    "alarms",
    "identity",
    "sidePanel"
  ],
  "host_permissions": [],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; connect-src 'self' https://www.googleapis.com https://api.github.com; img-src 'self' data: blob:; frame-src 'none'; object-src 'none'"
  },
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
